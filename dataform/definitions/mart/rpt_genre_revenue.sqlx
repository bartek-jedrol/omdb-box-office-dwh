config {
  type: "view",
  schema: "mart",
  description: "Revenue per genre for the dashboard. A movie with three genres is counted once in each of them, so the sum of all genres is bigger than the real total"
}

with

joined as (

  select
    fct_daily_revenue.screening_date as screening_date,
    bridge_movie_genre.genre as genre,
    fct_daily_revenue.revenue as revenue

  from ${ref("fct_daily_revenue")} as fct_daily_revenue

  -- movies with no genre in OMDb are left out
  inner join ${ref("bridge_movie_genre")} as bridge_movie_genre
    on fct_daily_revenue.movie_key = bridge_movie_genre.movie_key

)

select * from joined

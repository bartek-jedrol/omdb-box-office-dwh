config {
  type: "table",
  schema: "mart",
  description: "One row per calendar day covered by the box office file"
}

with

days as (

  select date

  from unnest(generate_date_array('2000-01-01', '2023-03-06')) as date

),

date_parts as (

  select
    cast(format_date('%Y%m%d', date) as int64) as date_key,
    date,
    extract(year from date) as year,
    extract(month from date) as month,
    -- Monday = 1 ... Sunday = 7
    mod(extract(dayofweek from date) + 5, 7) + 1 as day_of_week,
    format_date('%a', date) as day_name

  from days

)

select * from date_parts
